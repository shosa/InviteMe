{
  "name": "inviteme",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @inviteme/api",
    "dev:web": "npm run dev -w @inviteme/web",
    "build": "npm run build -w @inviteme/web",
    "typecheck": "npm run typecheck -w @inviteme/api && npm run typecheck -w @inviteme/web",
    "smoke": "npm run smoke -w @inviteme/api"
  },
  "devDependencies": {
    "embedded-postgres": "^17.6.0-beta.15"
  }
}
