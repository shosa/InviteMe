# Copia in .env.local e compila. Senza Shopify né ALLOW_LOCAL_CHECKOUT non è possibile pagare in produzione.

# URL pubblico dell'app (usato nei link delle email)
APP_URL=http://localhost:3000

# Email transazionali (Resend). Senza RESEND_API_KEY le email finiscono in data/outbox.json.
RESEND_API_KEY=
MAIL_FROM=InviteMe <ciao@tuo-dominio.it>

# Shopify (Storefront API): checkout e pagamenti
SHOPIFY_STORE_DOMAIN=tuo-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# ID della variante "Invito digitale" (gid://shopify/ProductVariant/123)
SHOPIFY_VARIANT_ID=

# Webhook orders/paid: segreto di firma (Shopify Admin > Notifiche > Webhook)
SHOPIFY_WEBHOOK_SECRET=

# Dashboard admin (/dashboard). Obbligatoria in produzione.
ADMIN_TOKEN=

# Solo per test in produzione senza Shopify. Non usare con clienti reali.
ALLOW_LOCAL_CHECKOUT=false
