# Copia in .env nella stessa cartella di docker-compose.yml e compila.

# Database (usato da docker compose)
POSTGRES_PASSWORD=cambia-questa-password-lunga

# Indirizzo pubblico del sito (usato nei link delle email)
APP_URL=http://localhost:3000
WEB_PORT=3000

# Console admin: ADMIN_EMAIL diventa amministratore alla registrazione; ADMIN_TOKEN serve per l'API
ADMIN_EMAIL=tuaemail@esempio.it
ADMIN_TOKEN=cambia-questo-token-lungo

# Email (Resend). Senza RESEND_API_KEY le email restano nel database e non partono.
RESEND_API_KEY=
MAIL_FROM=InviteMe <ciao@tuo-dominio.it>

# Shopify: checkout e pagamenti
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_VARIANT_ID=
SHOPIFY_WEBHOOK_SECRET=

# Solo per test senza Shopify. Lasciare false con clienti reali.
ALLOW_LOCAL_CHECKOUT=false

# Accesso con Google (facoltativo). URI di reindirizzamento da registrare: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
