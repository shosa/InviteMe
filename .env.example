# Copia in .env.local e compila. Senza queste variabili InviteMe usa il checkout di prova locale.

# Shopify (Storefront API)
SHOPIFY_STORE_DOMAIN=tuo-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# ID della variante prodotto "Invito digitale" (formato gid://shopify/ProductVariant/123)
SHOPIFY_VARIANT_ID=

# Webhook orders/paid: segreto di firma (Shopify Admin > Notifiche > Webhook)
SHOPIFY_WEBHOOK_SECRET=
